[Unit]
Description=Harmony Hub Web Controller
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/lib/harmony-web
# Optional override; omit for automatic discovery.
# Environment="HARMONY_IP=192.168.1.123"
Environment="URL_PREFIX=/harmony"
Environment="PORT=5000"
Environment="ENVIRONMENT=production"
ExecStart=/bin/sh -c '/var/lib/harmony-web/venv/bin/gunicorn --bind 127.0.0.1:${PORT} --workers 2 --threads 4 --timeout 60 --access-logfile - --error-logfile - app:app'
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/harmony-web/static/images/activities

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=harmony-web

[Install]
WantedBy=multi-user.target
