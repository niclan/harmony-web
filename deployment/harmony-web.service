[Unit]
Description=Harmony Hub Web Controller
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/harmony-web
Environment="HARMONY_IP=192.168.1.123"
Environment="URL_PREFIX=/harmony"
Environment="FLASK_DEBUG=False"
ExecStart=/opt/harmony-web/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --threads 4 --timeout 60 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/harmony-web/static/images/activities

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=harmony-web

[Install]
WantedBy=multi-user.target
