[Unit]
Description=Harmony Hub Web Controller
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/lib/harmony-web
# Optional override; omit for automatic discovery.
# Environment="HARMONY_IP=192.168.1.123"
Environment="URL_PREFIX=/harmony"
Environment="PORT=5000"
Environment="ENVIRONMENT=production"
Environment="PYTHONDONTWRITEBYTECODE=1"
# One worker keeps a single Hub connection; threads handle concurrent requests.
ExecStart=/var/lib/harmony-web/venv/bin/python -m gunicorn --bind 127.0.0.1:${PORT} --workers 1 --threads 4 --timeout 75 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/harmony-web/static/images/activities

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=harmony-web

[Install]
WantedBy=multi-user.target
